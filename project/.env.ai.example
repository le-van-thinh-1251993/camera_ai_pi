# ===== Module AI (Gemini) - chep thanh .env.ai roi dien key =====
# Tren Pi: ~/ai-camera-release/.env.ai   (installer tu tao tu file nay neu chua co)
# Tren Windows: d:\IOT\project\.env.ai
# File .env.ai KHONG duoc commit (.gitignore da chan .env.*). Khoa quyen: chmod 600.

# Key lay tu Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ma model (khong phai ten hien thi). Do that 11/2026: gemini-3.5-flash ~2,4 s (muc suy nghi low).
# Khong dung model *-tts / *-image (chi tao giong/anh). gemini-2.5-flash da ngung cho nguoi dung moi.
GEMINI_MODEL=gemini-3.5-flash
# Model du phong khi model chinh het luot / qua gio / loi mang / sai ten model.
# Do that: gemini-3.5-flash-lite ~1,4 s. De trong = gemini-3.5-flash-lite. "none" = tat du phong.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Giay cho model du phong (2-30). Het ca hai -> bo dung cau co dinh.
GEMINI_FALLBACK_TIMEOUT=4
# Muc suy nghi cua model chinh dong 3.x: low (nhanh) | medium | high. De trong = mac dinh cua model.
GEMINI_THINKING_LEVEL=low
# Chi cho dong gemini-2.5: so token suy nghi (0 = tat).
GEMINI_THINKING_BUDGET=0
# Giay cho Gemini tra loi (2-30). Qua gio -> bo dung cau co dinh.
GEMINI_TIMEOUT=6

# Gui ca anh cho Gemini (1) hay chi gui con so (0)
AI_SEND_IMAGE=1
# Canh dai toi da cua anh gui di (px)
AI_IMAGE_SIDE=768

# Phong cach cau AI tu nghi
AI_STYLE=vui vẻ, tích cực, ấm áp, giống lời chúc ngắn
# Do dai toi da cua cau (ky tu) - the "Y nghia" tren TFT hien ~5 dong
AI_MAX_CHARS=100
# So luot goi Gemini toi da moi ngay (chan ton tien)
AI_DAILY_LIMIT=500

# Giong doc: thu lan luot (gemini = Gemini TTS chinh thuc, edge = Edge TTS du phong + ffmpeg)
AI_TTS=gemini,edge
# Model giong, thu lan luot (moi model co han muc Free rieng: 3.8-flash-tts chi 10 luot/ngay).
# Do that: ca hai = giong nu mien Bac. KHONG dung gemini-3.8-flash-lite-tts (doc ca loi dan ra loa).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
# Giong Gemini (nu): Kore, Aoede, Despina, Callirrhoe...
GEMINI_TTS_VOICE=Kore
# Loi dan giong doc (khong bi doc ra). Do that: Kore + loi dan nay = nu mien Bac, tu nhien 10/10,
# khop giong file ghi am san co. "none" = khong dan (Kore se ra giong mien Nam).
GEMINI_TTS_STYLE=Giọng nữ Hà Nội, nói nhanh, liền mạch
GEMINI_TTS_TIMEOUT=10
# Giong Edge TTS (du phong) - HoaiMy cung la giong nu mien Bac
AI_VOICE=vi-VN-HoaiMyNeural
AI_VOICE_RATE=+0%

# Cong noi bo (core goi http://127.0.0.1:8010). Khong mo ra mang ngoai.
AI_HOST=127.0.0.1
AI_PORT=8010

# ===== Phat lai (khong ton luot Gemini) =====
# gemini = goi that (demo). replay = lay cau + giong da luu tu cac lan chay that (test thoai mai).
AI_PROVIDER=gemini
# Gemini loi / het luot -> phat lai cau da luu cung so ngon thay vi cau co dinh (1 = bat)
AI_REPLAY_FALLBACK=1
# Giay cho gia khi phat lai (0 = tra ngay; dat 3 de giong thoi gian chay that)
AI_REPLAY_DELAY=0
