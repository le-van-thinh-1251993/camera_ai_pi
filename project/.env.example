HOST=0.0.0.0
PORT=8000
MODEL_PATH=models/gesture_recognizer.task
DATA_DIR=data
MIN_SCORE=0.65
MAX_UPLOAD_MB=3
MAX_PIXELS=12000000
MAX_SIDE=1280
HISTORY_LIMIT=50
# Để trống chỉ phù hợp mạng LAN tin cậy; đặt chuỗi ngẫu nhiên trước khi triển khai.
API_KEY=
# ESP32 LAN fallback key. If empty, the dashboard API_KEY is used.
LAN_API_KEY=
LAN_HOSTNAME=ai-camera.local
# Dùng file thu âm, không cần API TTS.
TTS_PROVIDER=recording
MAX_PHOTO_MB=15
MAX_PHOTO_PIXELS=50000000
# Cloud credentials live in .env.cloud (not in public source).
# Khi Supabase mất kết nối, dashboard sẽ nhận diện cục bộ trên Pi và lưu kết quả vào SQLite.
CLOUD_LOCAL_FALLBACK=1
